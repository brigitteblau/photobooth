# Copiá este archivo a .env.local y completá según tu impresora.
# Para ver el nombre exacto de tus impresoras abrí en el navegador:
#   http://localhost:3000/api/print
# (Windows usa Get-Printer; macOS/Linux usan lpstat -p -d)

# Nombre EXACTO de la impresora tal como aparece en el sistema.
# Si lo dejás vacío, usa la impresora default del sistema.
PRINTER_NAME=

# Cantidad de copias por sesión.
PRINT_COPIES=1

# --- WINDOWS (recomendado) ---
# Ruta a SumatraPDF para impresión silenciosa de buena calidad.
# Descargalo de https://www.sumatrapdfreader.org (versión portable sirve).
# Ejemplo: C:\Tools\SumatraPDF\SumatraPDF.exe
# Si lo dejás vacío, se usa mspaint /pt (incluido en Windows). En ese caso
# configurá el tamaño de papel en las preferencias del driver de la impresora.
SUMATRA_PATH=

# --- macOS / Linux (CUPS) ---
# Tamaño de papel para `lp`. Ej: 4x6.Borderless, Custom.2x6in, A6, Letter.
# (Ignorado en Windows.)
PRINT_MEDIA=
